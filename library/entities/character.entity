    {
      "$id": "939ffc85-78af-4aca-bf69-7d6502a20259",
      "code": "//script which tells the character to go to the \"land_light\" animation if you land during the attack.\r\nCommon.setAutocancel(true);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "6af26e3b-989a-480e-a885-522b1ef7875b",
      "code": "",
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "c448e57d-77e9-4b77-9b6f-be1dc429c026",
      "code": "//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();\r\n//script which tells the character to go to the land animation designated in the AnimationStats.hx for this attack if you land during it.\r\nCommon.setAutocancel(false);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "68fd1c6b-f623-4573-aae1-71272049f7a5",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "c7abc6aa-6996-437f-ad0f-e644bde4ad0b",
      "code": "//calls generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_3);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bbd30efa-f900-4dea-93de-6ed8a7cf79e4",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
