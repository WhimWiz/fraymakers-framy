    {
      "$id": "c49e5635-f8ef-46b3-a914-81e61cc70caa",
      "code": "//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "8e0f248c-3467-4cd9-b19b-0ab6b069c02c",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
