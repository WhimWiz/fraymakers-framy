    {
      "$id": "4223e61b-9682-4bc9-94e1-739882f7c4cf",
      "code": "//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "94ac8b1d-4581-4ebd-9c64-30de0bb0a050",
      "code": "//TEAM FRAY NOTE - this is the backward roll out of crash_loop. Fraymakers doesn't have separate rolls for forward versus backward, so if you would like parity with the game animate your character rolling backward out of \"crash_roll\" and then transitioning to \"stand\"\r\n\r\n//calls a light dust effect displaced backward one pixel (x:-1) and flipped horizontally (scaleX:-1)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_START_LIGHT, x:-1, scaleX:-1}), self);\r\n//play generic roll sound\r\nAudioClip.play(GlobalSfx.ROLL);\r\n//set intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "952896e0-2473-4dbf-a1e5-a8c292a86da0",
      "code": "//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
