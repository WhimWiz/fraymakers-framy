    {
      "$id": "6ebd64b1-f9f7-43e9-ac7d-0a232a8d8269",
      "code": "//updates the hitbox stats for hitbox0 (indicated by the 0 at the start of the parenthesis)\r\nself.updateHitboxStats(0, {damage: 10, knockbackGrowth: 60, baseKnockback: 60, hitstop: -1, selfHitstop: -1, hitstun: -1, hitstopNudgeMultiplier:1, directionalInfluence: true, reversibleAngle:false, angle: 55, limb:AttackLimb.FIST });\r\n//updates the hitbox stats for hitbox1 (indicated by the 1 at the start of the parenthesis)\r\nself.updateHitboxStats(1, {damage: 10, knockbackGrowth: 60, baseKnockback: 60, hitstop: -1, selfHitstop: -1, hitstun: -1, hitstopNudgeMultiplier:1, directionalInfluence: true, reversibleAngle:false, angle: 55, limb:AttackLimb.FIST });\r\n//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();\r\n//adds event listener which runs a script that allows you to jump cancel the attack if the hit is successful (this script can be managed in the character's Script.hx)\r\nself.addEventListener(GameObjectEvent.HIT_DEALT, sideSpecialHit);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "1883bf7c-6ff3-41b0-ad74-9fddce1f9a84",
      "code": "//plays a generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_3);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "d080051f-5abe-4919-93f2-596c7e27c1eb",
      "code": null,
      "length": 11,
