    {
      "$id": "68f98e11-8211-4324-a2fa-079431780299",
      "code": "//adds event listener which runs a script that slows movement down if hitting a shield (this script can be managed in the character's Script.hx)\r\nself.addEventListener(GameObjectEvent.SHIELD_HIT_DEALT, sideSpecialShieldHit);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "332f116c-11da-4969-8844-ab6f00f0dc09",
      "code": "",
      "length": 3,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "37a00389-1beb-4832-9f48-9c7c70eaf9e3",
      "code": "//adds damage armor to the character\r\nself.updateAnimationStats({bodyStatus:BodyStatus.DAMAGE_ARMOR, bodyStatusStrength:15});\r\n//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "8132c46a-203f-42df-b6a4-7a84dd58abd1",
      "code": "",
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "45e94e99-2498-4ab6-80d4-8b9a41272d0f",
      "code": "//gives the character a speed boost forward and up (to set backward speed put a negative number in the setXSpeed parentheses, and to go up set a positive number in the setYSpeed parentheses)\r\nself.setXSpeed(8);\r\nself.setYSpeed(-15);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "1fe14de5-b494-4168-80c7-38dd3e9bce7f",
      "code": "//allows you to influence your character's momentum during the attack\r\nself.updateAnimationStats({allowMovement: true, groundSpeedCap: 44, aerialSpeedCap: 26});\r\n//plays a generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "941d786b-9d34-4192-bc59-a5f162c7cdcc",
      "code": "//removes previously set damage armor\r\nself.updateAnimationStats({bodyStatus:BodyStatus.NONE});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "5d49caa3-0ebe-44f1-96f6-370adedc6421",
      "code": null,
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "f8185b47-70eb-40c7-ae2e-e264b3373a47",
      "code": "//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "da4a3218-824d-4dcf-9e36-e52e3e24a433",
      "code": "//boosts x speed horizontally by the positive number in the parenthesis (for backward use a negative number)\r\nself.setXSpeed(8);\r\n//plays a generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "8430b743-0fa6-4036-88d7-d247b7943ef4",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
