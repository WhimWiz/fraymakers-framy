    {
      "$id": "0b5ed261-fcba-4808-b2dd-82c725164f12",
      "code": "//adds event listener which runs a script that slows movement down if hitting a shield (this script can be managed in the character's Script.hx)\r\nself.addEventListener(GameObjectEvent.SHIELD_HIT_DEALT, sideSpecialShieldHit);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "915c94e0-dd67-4e55-bab3-e6cb896957e0",
      "code": "",
      "length": 3,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "2b3e2762-0e5d-4e4d-b9fc-8cf8d1e90064",
      "code": "//adds damage armor to the character\r\nself.updateAnimationStats({bodyStatus:BodyStatus.DAMAGE_ARMOR, bodyStatusStrength:15});\r\n//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "6ce9e30a-0522-4a68-888a-4837171190d7",
      "code": "",
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "01f9e9e1-1885-4af8-a1d4-c4ae682da5f5",
      "code": "//gives the character a speed boost forward and up (to set backward speed put a negative number in the setXSpeed parentheses, and to go up set a positive number in the setYSpeed parentheses)\r\nself.setXSpeed(8);\r\nself.setYSpeed(-15);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "4ee99e89-dba1-4622-ac79-fe3aaf15641c",
      "code": "//allows you to influence your character's momentum during the attack\r\nself.updateAnimationStats({allowMovement: true, groundSpeedCap: 44, aerialSpeedCap: 26});\r\n//plays a generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "27891b33-db3c-4d4d-8629-0aa2e5813591",
      "code": "//removes previously set damage armor\r\nself.updateAnimationStats({bodyStatus:BodyStatus.NONE});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "986e66e1-f46e-40dc-bfed-ea511fe20d49",
      "code": null,
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "5c54d426-8857-42f7-887e-7363a64f6ca7",
      "code": "//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e73fa18e-2357-4ca0-a3d0-307d64c30c77",
      "code": "//boosts x speed horizontally by the positive number in the parenthesis (for backward use a negative number)\r\nself.setXSpeed(8);\r\n//plays a generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e099f3aa-e51e-4607-b3f0-a7eb2182c621",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
