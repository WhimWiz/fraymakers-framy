    },
    {
      "$id": "8ab27a75-c0d3-4e7f-a95b-6a37a59e5d19",
      "code": "//calls a light dust effect displaced five frames forward (x:5), and flipped horizontally (scaleX:-1)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_START_LIGHT, x:5, scaleX:-1}), self);\r\n//plays a generic roll sound \r\nAudioClip.play(GlobalSfx.ROLL);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
