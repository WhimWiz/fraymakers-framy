    {
      "$id": "0a4be61f-384e-45a9-8a69-0a373280fd27",
      "code": "match.createVfx(new VfxStats({\r\n    spriteContent: \"global::vfx.vfx\",\r\n    animation: GlobalVfx.DOUBLE_JUMP_DUST,\r\n    x: self.getX(),\r\n    y: self.getY(),\r\n    layer: VfxLayer.FOREGROUND_EFFECTS\r\n}));\r\nmatch.createVfx(new VfxStats({\r\n    spriteContent: \"global::vfx.vfx\",\r\n    animation: GlobalVfx.DOUBLE_JUMP_DUST_BACK,\r\n    x: self.getX(),\r\n    y: self.getY(),\r\n    layer: VfxLayer.BACKGROUND_EFFECTS\r\n}));",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "eb6004b3-0fd3-4893-94f3-87ac90b37c9e",
      "code": "//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();\r\n\r\nself.setXSpeed(UP_SPECIAL_SPEED_X);\r\nself.setYSpeed(UP_SPECIAL_SPEED_Y / 1.25);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "436cb5dd-ef8a-40e4-83bc-01dcc96fa613",
      "code": "",
      "length": 3,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "db664974-4a21-4af3-b718-82151183088a",
      "code": "",
      "length": 5,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "af1c2b9f-ee3c-4d94-99e6-7662e27f75b1",
      "code": "self.playAnimation(\"special_up_loop\");",
      "length": 1,
      "pluginMetadata": {
