    {
      "$id": "01ddfd71-ce70-447f-9a66-c4df6b21dfa2",
      "code": "self.unattachFromFloor();\r\nself.setYSpeed(-7);\r\nself.setXSpeed(13);\r\nairdashVfx.set(match.createVfx(new VfxStats({\r\n    spriteContent: self.getResource().getContent(\"framy\"),\r\n    animation: \"vfx_airdash_sparkles\",\r\n    layer: VfxLayer.BACKGROUND_EFFECTS,\r\n    x: 18,\r\n    y: self.getEcbRightHipY() + 26,\r\n    scaleX: 1.6,\r\n    scaleY: 1.1\r\n}, self)));\r\nairdashVfx.get().attachTo(self);\r\nif (self.isFacingLeft()) {\r\n    airdashVfx.get().flip();\r\n}\r\n",
      "length": 1,
      "pluginMetadata": {
      },
