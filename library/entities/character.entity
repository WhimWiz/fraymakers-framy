      "code": "//forces enemy character into frame 11 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(11);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
