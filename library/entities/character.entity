    {
      "$id": "8d8d5076-2838-4afb-94b5-778a51d7c345",
      "code": "//boosts x speed horizontally by the positive number in the parenthesis (for backward use a negative number)\r\nself.setXSpeed(8);\r\n//plays a generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);",
      "length": 1,
