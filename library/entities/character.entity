    },
    {
      "$id": "b440ec7f-0fc6-4116-8d3f-e68c243622cd",
      "code": "//forces enemy character into frame 10 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(10);\r\n}",
