    },
    {
      "$id": "72a69b88-9aa5-4f33-be36-f427cfe70c26",
      "code": "//plays generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_3);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "948324df-817e-4778-982d-3336f82a543e",
      "code": "//plays light dust effect displays downward 3 pixels (y:3)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_START_LIGHT, y:3}), self);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "3331fac5-8319-471e-a627-2860e8b667e6",
      "code": "//boosts x speed horizontally by the positive number in the parenthesis (for backward use a negative number)\r\nself.setXSpeed(10);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "79ebb26f-55ae-4129-b4af-da56e8eedb06",
      "code": "",
      "length": 7,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "0dd2a4f7-d317-4eac-9233-8a9ec801594d",
      "code": "//slows character's x speed by multiplying their current x speed by the decimal in the parenthesis\r\nself.setXSpeed(self.getXSpeed()*0.75);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e5b9472b-7dd3-4199-8755-12b8f7747e3a",
      "code": "",
