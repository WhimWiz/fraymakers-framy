      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "be1b156f-35f7-4788-84e7-0f6dc6d1adfe",
      "code": "//plays generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);\r\n//updates the hitbox stats for hitbox0 (indicated by the 0 at the start of the parenthesis)\r\nself.updateHitboxStats(0, {damage: 5, angle: 80, baseKnockback: 55, knockbackGrowth: 75, hitstop:-1, selfHitstop:-1, hitstopNudgeMultiplier:1, knockbackCap:-1, tumbleType: TumbleType.AUTO});\r\n//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "775914ec-5e15-4419-b210-8f8a7c59580b",
      "code": "",
      "length": 16,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
