      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "72093c31-be98-48a5-a10b-de0dc3963910",
      "code": "//re-enables your ability to influence your character's momentum, but at a reduced rate\r\nself.updateAnimationStats({allowMovement: true, groundSpeedCap: 3.3, aerialSpeedCap: 1.95});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
