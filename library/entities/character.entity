    {
      "$id": "475a88ed-828c-445f-9a0f-4b2411c72fb4",
      "code": "//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "12b7d5c9-fb79-4731-8092-bc523bda436b",
      "code": "//plays generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_3);\r\nself.addEventListener(GameObjectEvent.HIT_DEALT, function(event:GameObjectEvent){\r\n    if (event.data.foe.getHitstun() != 0 && event.data.hitboxStats.index == 0) {\r\n        event.data.foe.setX(self.getX() + self.flipX(52));\r\n        event.data.foe.setY(self.getY() + -55);\r\n    }\r\n});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "c34518f4-4a80-43ea-bcee-14262bab2d81",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
