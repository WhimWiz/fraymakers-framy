    {
      "$id": "1b6f5736-a02f-47e1-b562-d53f14f1fa0f",
      "code": "//calls airdash dust effect. Number in the parenthesis indicates the direction in degrees.\r\nCommon.generateAirdashVfx(0);\r\n\r\ngenerateFramyAirdashVfx(0);",
