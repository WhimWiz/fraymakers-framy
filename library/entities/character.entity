    {
      "$id": "7d20b815-3a8b-4a89-b42a-76e73cd8c821",
      "code": "//script which tells the character to go to the \"land_light\" animation if you land during the attack.\r\nCommon.setAutocancel(true);\r\n//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "dd75d9ee-b864-4b77-9716-f9fe80f88b69",
      "code": "//plays generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "d9443a7a-f011-42a2-aa8b-7fd6b99f0b98",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "48510dba-6a23-4503-a66e-66984f934a59",
      "code": "//script which tells the character to go to the land animation designated in the AnimationStats.hx for this attack if you land during it.\r\nCommon.setAutocancel(false);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "ef29bee4-57a7-43d1-bb7f-a68f3d8d3252",
      "code": "//updates the hitbox stats for hitbox0 (indicated by the 0 at the start of the parenthesis)\r\nself.updateHitboxStats(0, {damage: 7, baseKnockback:25});\r\n//updates the hitbox stats for hitbox1 (indicated by the 1 at the start of the parenthesis)\r\nself.updateHitboxStats(1, {damage: 7, baseKnockback:25});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "36cc73b3-f52c-4b72-baec-ae945a1d9083",
      "code": "",
      "length": 2,
