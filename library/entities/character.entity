    {
      "$id": "f780aeba-916a-44d1-8506-979f00d51f90",
      "code": "//logic located in Script.hx which tells the character if the attack button is held to loop back to frame 2 of this animation\r\njab3Loop();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "ba709a69-fa11-415d-b573-675ec3d775d5",
      "code": "//updates the hitbox stats for hitbox0 (indicated by the 0 at the start of the parenthesis)\r\nself.updateHitboxStats(0, {damage: 4, angle: 37, baseKnockback:50, knockbackGrowth:60, hitstop:-1, selfHitstop:-1, hitstopNudgeMultiplier: 1});\r\n//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "be3ed43f-2b81-43a5-b215-b222172905c1",
      "code": "//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
