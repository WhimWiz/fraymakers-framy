    {
      "$id": "a75fd24b-a814-412c-974e-162c9c1fb378",
      "code": "//TEAM FRAY NOTE - for Fraymakers parity, parry is a 3 frame window, so this animation should be 3 frames long.\r\n\r\n//plays an effect that indicates how long the parry window is.\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: \"vfx_parry_in\", layer:VfxLayer.CHARACTERS_BACK, x:6, y:21}), self);",
