    {
      "$id": "9ac9f50d-8fea-4551-9ac1-f3b15a8b85d5",
      "code": "//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "32514d5e-66f0-433d-9190-7926f9be9e81",
      "code": "",
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "865469bb-cd4a-4a28-b833-465eb42638cb",
      "code": "//script which resets any previous momentum your character had\r\nself.resetMomentum();\r\n\r\n//gives the character a speed boost forward and up (to set backward speed put a negative number in the setXSpeed parenthesis, and to go up set a positive number in the setYSpeed parenthesis)\r\nself.setXSpeed(5);\r\nself.setYSpeed(-21);\r\n\r\n//removes your ability to influence your character's movement in the ground or air\r\nself.updateAnimationStats({allowMovement:false});\r\n\r\n//plays a generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_3);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "dc0b7a5e-ca94-40de-8f44-4fb301be3767",
      "code": "//tells the character to enter the \"land_heavy\" animation if landing passed this point in the animation\r\nself.updateAnimationStats({landType:LandType.NORMAL, landAnimation:\"land_heavy\"});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e5239f9a-ec8a-455b-bb36-519533535782",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "7b7459e1-7e51-4425-ab69-37a17ecdfa3e",
      "code": "//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();\r\n\r\nself.updateHitboxStats(0, {baseKnockback: 100});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "b8f7504f-daf2-46e9-bf3d-82b8e514a12f",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "69bed715-7abb-44dd-af57-86f543fc17d9",
      "code": "//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "43145068-8ebd-4ad2-9f1d-918c439b4892",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "81a7ea69-c5ed-40c0-a68c-04b77b9b3bb2",
      "code": "//updates the hitbox stats for hitbox0 (indicated by the 0 at the start of the parenthesis)\r\nself.updateHitboxStats(0, {damage: 10, angle: 75, baseKnockback:75, knockbackGrowth:45, hitstop: -1, selfHitstop: -1, hitstopNudgeMultiplier:1, directionalInfluence: true});\r\n//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
