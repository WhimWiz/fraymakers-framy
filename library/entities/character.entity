    {
      "$id": "63cbfd03-754c-42c5-825d-4af2f8403dc5",
      "code": "",
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "c0e31c0d-e370-4025-b349-6f2e7ed8fc90",
      "code": "//forces enemy character into frame 3 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(3);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "02138d94-4269-4b27-ad9f-d384b76133d6",
      "code": "",
      "length": 6,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "a60dc8ce-4aa6-4a57-9e84-1493b3f348f6",
      "code": "//calls a light dust effect\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_START_LIGHT}), self);\r\n//forces enemy character into frame 2 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(2);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "c4166390-e9b6-4900-9b77-e1064275fdef",
      "code": "//calls generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_2);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "1ac270cd-0e38-44f0-b229-ddebab894c33",
