    {
      "$id": "b2fdd779-d4b7-4adb-befb-b80cf3f2c091",
      "code": "//forces enemy character into frame 2 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(2);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "12d0c0fd-fdab-4af8-bafb-0fded823346a",
      "code": "",
      "length": 6,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "70c9e69c-3025-460b-8bd0-9a382776bbf6",
      "code": "//forces enemy character into frame 3 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(3);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "9e2e998f-b48a-4e94-a9a1-4582e8f3a29e",
      "code": "",
