    },
    {
      "$id": "72fd0a44-6b65-4472-9a32-a8d3e6b8c59b",
      "length": 1,
      "name": "",
      "pluginMetadata": {
      },
      "type": "LABEL"
    },
    {
      "$id": "516815f1-409a-4e99-b1f0-24eb48d7b3db",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "99b0a1ef-7fb6-401a-a947-5abf65dba473",
      "length": 1,
      "pluginMetadata": {
      },
      "symbol": null,
      "tweenType": "LINEAR",
      "tweened": false,
      "type": "IMAGE"
    },
    {
      "$id": "0303818f-9d2f-435e-bb91-20d6c03b7d56",
      "code": "//TEAM FRAY NOTE - standard length for this animation is 75 frames. You can make it shorter if you'd like, and as soon as it ends it will jump to the character's \"stand\" animation. Anything longer than 75 frames gets cut off by \"stand\" at the 75th frame (which is when the match starts and the character becomes actionable).",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "93fae912-cdd3-44bd-a174-bfbe3a2b3822",
      "code": "//TEAM FRAY NOTE - animates from \"run\" to \"stand\".",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "16589c5f-622b-417e-96f6-7bf99eb364b5",
      "code": "//TEAM FRAY NOTE - start of jump cycle animation.",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "ba98c551-bbf7-4eaa-85d0-cb79e4046084",
      "code": "//TEAM FRAY NOTE - plays when you airdash into a floor.\r\n\r\nonWavedash();\r\nreturn;\r\n\r\n//calls a dust poof\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_POOF}), self);\r\n//calls a separate dust poof behind the character\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", layer:VfxLayer.CHARACTERS_BACK, animation: GlobalVfx.DUST_POOF_BACK}), self);\r\n\r\n//reduces waveland speed based on the provided arguments\r\nCommon.reduceWavelandSpeed(11, 0.9);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "74f63848-cce0-4799-b1bf-a77161c18d06",
      "code": "//TEAM FRAY NOTE - transition between \"jump_squat\" and \"jump_loop\".",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "9d9e6014-abdb-4873-9a44-0f247d6804b5",
      "code": "//TEAM FRAY NOTE - this animation loops until you hit the maximum jump height, where it then transitions to \"jump_out\".",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "6a91d910-917f-41f9-8a73-a3235ca9ae0a",
      "code": "AudioClip.play(GlobalSfx.DOUBLE_JUMP);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "54288750-a92f-49e8-842d-e6d42ec8f34e",
      "code": "",
      "length": 12,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "7fbd5f01-0e55-456d-98fa-8884f73a9d07",
      "code": "//TEAM FRAY NOTE - generic landing lag.\r\n\r\n//plays a generic landing sound effect\r\nAudioClip.play(GlobalSfx.LAND);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "a521b211-c6ca-4bff-8ed1-849c84a99a6b",
      "code": "",
      "length": 15,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "9df66ffc-eb52-4f76-9f42-5a49eca9a8ed",
      "code": "//TEAM FRAY NOTE - longer landing lag for whatever animation you designate. \r\n\r\n//calls a generic landing sound\r\nAudioClip.play(GlobalSfx.LAND);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bbb1c791-e981-4824-89f3-78aa27388a32",
      "code": "//TEAM FRAY NOTE - landing lag from airdash freefall. In Fraymakers this is currently standardized across the cast at 20 frames.\r\n\r\n//calls a generic landing sound \r\nAudioClip.play(GlobalSfx.LAND);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e11fe903-cb8a-4d2f-8394-b5c3771dec49",
      "code": "//TEAM FRAY NOTE - extended landing lag after an airdash where you also input an aerial and missed. In Fraymakers this is currently standardized across the cast at 30 frames.\r\n\r\n//calls a generic landing sound \r\nAudioClip.play(GlobalSfx.LAND);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "32c5f509-5242-4c1f-ab79-f5f43336fe14",
      "code": null,
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "20ead6d0-0eec-49e9-8c70-891b6eb9382f",
      "code": "",
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e08777eb-3db3-425a-bbec-22f0ca706ab2",
      "code": "//TEAM FRAY NOTE - position the \"ledgeholdpoint0\" layer's point where you'd like your character to be grabbing the ledge. Keep this point above 0,0 to prevent funkiness. \r\n\r\n//plays a ledge grab sound\r\nAudioClip.play(GlobalSfx.LEDGE_GRAB);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "8ee84001-7c24-4e50-9ad2-b593bba5af04",
      "code": "//TEAM FRAY NOTE - as your character animates up onto the ledge, slowly move the \"ledgeholdpoint0\" closer to 0,0 on each keyframe, and fully positioned at 0,0 when you want your character to appear on stage. Ledge climb intangibility for the Fraymakers cast is currently standardized to frames 1 through 25.\r\n\r\n//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bb80c0ae-0b4f-4d83-81a8-5dcb14d3d6c7",
      "code": "//TEAM FRAY NOTE - as your character animates up onto the ledge, slowly move the \"ledgeholdpoint0\" closer to 0,0 on each keyframe, and fully positioned at 0,0 by the end of this animation. \"Ledge_roll_in\" and \"ledge_roll\" are separated to easily distinguish between connected to the ledge and disconnected. \r\n\r\n//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "4e372218-72e9-4c2d-8fc8-1568dca82f38",
      "code": "//TEAM FRAY NOTE - plays directly from \"ledge_roll_in\" and you are no longer considered attached to the ledge. \r\n\r\n//plays generic roll sound\r\nAudioClip.play(GlobalSfx.ROLL);\r\n\r\n//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "f804ce3b-cd2c-4f13-9b7a-469b30e79b69",
      "code": "//TEAM FRAY NOTE - as your character animates up onto the ledge, slowly move the \"ledgeholdpoint0\" closer to 0,0 on each keyframe, and fully positioned at 0,0 by the end of this animation. \"Ledge_jump_in\" and \"ledge_jump\" are separated to easily distinguish between connected to the ledge and disconnected. \r\n\r\n//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "5ae8c267-4a32-4976-abd5-d3c8cc8c6d79",
      "code": "//TEAM FRAY NOTE - plays directly from \"ledge_jump_in\" and you are no longer considered attached to the ledge. In Fraymakers this animation is used as a transition frame between the ledge and their \"jump_in\" animation, but you could utilize this animation to create a more complex custom ledge jump animation if you'd like. Be mindful that if you do so, you'll have to change when the jump speed is applied and which state+animation \"ledge_jump\" transitions to (for more context, check the last keyframe on the Frame Script Layer).\r\n\r\n//plays generic jump sound\r\nAudioClip.play(GlobalSfx.JUMP);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e5c05a42-9df4-4b35-ab29-0c19b3647275",
      "code": "//TEAM FRAY NOTE - as your character animates up onto the ledge, slowly move the \"ledgeholdpoint0\" closer to 0,0 on each keyframe, and fully positioned at 0,0 by the end of this animation. \"Ledge_attack_in\" and \"ledge_attack\" are separated to easily distinguish between connected to the ledge and disconnected. \r\n\r\n//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "6a93952b-566d-433e-95ee-a31d99b328bf",
      "code": "",
      "length": 5,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "46384512-112d-4761-959d-83dbcd3cb11e",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "cf05bf58-81c1-4d4a-bdb6-62fd6aef522c",
      "code": "//plays a random shield hit sound on hit\r\nCommon.playRandomShieldHitSound();\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "8e8deebd-8238-4cdc-bfdc-12de37cde8c9",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "607268dd-740e-4e65-a297-d97234377c56",
      "code": "//TEAM FRAY NOTE - this is the backward roll out of shield. Fraymakers doesn't have separate rolls for forward versus backward, so if you would like parity with the game animate your character rolling backward out of \"shield_loop\" and then transitioning to \"stand\"",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "a79c67ff-d5ef-40cb-91af-429446a4c1f2",
      "code": "//TEAM FRAY NOTE - in Fraymakers tech invincibility is currently standardized to frames 1 through 20.\r\n\r\n//calls a generic landing sound\r\nAudioClip.play(GlobalSfx.LAND);\r\n//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "a85be763-d49a-420c-8c52-af21f8095719",
      "code": "//TEAM FRAY NOTE - in Fraymakers tech invincibility is currently standardized to frames 1 through 20.\r\n\r\n//calls a generic landing sound\r\nAudioClip.play(GlobalSfx.LAND);\r\n//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "d25532e2-b993-4437-b038-30e780d63228",
      "code": "//TEAM FRAY NOTE - plays only in the air when your character's bottom 1/3rd is hit. The Collision Body Layer is present with grounded settings to prevent the character from snapping upward when landing in a hurt light state.",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "fa29dcfb-09fd-45bf-b09b-e65071923be8",
      "code": "//TEAM FRAY NOTE - plays when your character's top 1/3rd is hit. The Collision Body Layer is present with grounded settings to prevent the character from snapping upward when landing in a hurt light state.",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "0a400f65-1db6-47da-a2aa-614aadfdb3c6",
      "code": "//TEAM FRAY NOTE - plays when the character recieves a medium amount of knockback. The script on all of the keyframes in this animation dictates which angle of tumble the character jumps to if hitstun ends before the animation does. \r\nCommon.setHurtMediumAngle(-90);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "3630ff9e-fc44-44ff-8104-6968d1fa0058",
      "code": "",
      "length": 8,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "f214d4be-66cf-4fd9-b6ab-d054f4401fd6",
      "code": "//plays generic crash sound\r\nAudioClip.play(GlobalSfx.CRASH_1);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "f65b932e-a1c3-4247-b0e8-8ea5c52e80ef",
      "code": "//TEAM FRAY NOTE - landing lag specifically for \"aerial_neutral\".\r\n\r\n//plays generic land sound\r\nAudioClip.play(GlobalSfx.LAND);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "b578c709-d81f-496e-a518-a03f4e667e07",
      "code": "//script which tells the character to go to the \"land_light\" animation if you land during the attack.\r\nCommon.setAutocancel(true);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "dad1c231-9834-4969-a202-29d2777067ba",
      "code": "//TEAM FRAY NOTE - landing lag specifically for \"aerial_forward\".\r\n\r\n//plays generic land sound\r\nAudioClip.play(GlobalSfx.LAND);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bef3ed47-6e5f-4e17-97ee-87250725ca8e",
      "code": "//TEAM FRAY NOTE - landing lag specifically for \"aerial_back\".\r\n\r\n//plays generic land sound\r\nAudioClip.play(GlobalSfx.LAND);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "b34ad51f-0fe5-42ab-a6c7-182a5bf88004",
      "code": "//script which tells the character to go to the \"land_light\" animation if you land during the attack.\r\nCommon.setAutocancel(true);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "c1caa3d5-c581-439d-98b4-95687007b7fa",
      "code": "//TEAM FRAY NOTE - landing lag specifically for \"aerial_down\".\r\n\r\n//plays generic land sound\r\nAudioClip.play(GlobalSfx.LAND);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "1c133710-254c-415d-af50-9686119525a4",
      "code": "\r\n//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "69bbe419-d001-472b-9d81-5191bcdf0dc6",
      "code": "//TEAM FRAY NOTE - landing lag specifically for \"aerial_up\".\r\n\r\n//plays generic land sound\r\nAudioClip.play(GlobalSfx.LAND);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "128cff1b-54a7-441e-ab2a-56304d9b441c",
      "code": "//gives the character a speed boost forward (to set backward speed put a negative number in the setXSpeed parenthesis)\r\nself.setXSpeed(12);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "630b9d06-3278-4516-8a87-3a8166f95b10",
      "code": null,
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "b447edec-3aea-4fa9-879f-470dce4cb8a6",
      "code": "Common.startJabComboCheck();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "f68741ea-3aab-4340-96d9-b969182e8174",
      "code": "",
      "length": 6,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "ce2a087c-d2f3-4346-9b5b-5dfed77148e4",
      "code": "",
      "length": 5,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "7eb9346b-9a71-4d9e-8f80-a7bf7a28b63a",
      "code": "",
      "length": 3,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "4a5665fc-2164-4544-9fa0-7c6c87f89838",
      "code": "//TEAM FRAY NOTE - animation which plays upon a successful parry.\r\n\r\n//calls parry effect\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: \"vfx_parry_ring\", x:6, y:21}), self);\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: \"vfx_parry_dust_front\", x:6, y:21}), self);\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: \"vfx_parry\", layer:VfxLayer.CHARACTERS_BACK, x:6, y:21}), self);\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: \"vfx_parry_dust_back\", layer:VfxLayer.CHARACTERS_BACK, x:6, y:21}), self);\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: \"vfx_parry_dust_behind\", layer:VfxLayer.BACKGROUND_BEHIND}), self);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "a0ff4839-2cd9-40b1-a958-fab6716ead28",
      "code": "//TEAM FRAY NOTE - period of strong attack prior to the charging animation.\r\n\r\n//calls a sparkle effect offset 60 pixels forward (x: 60) and up 20 pixels (y:-20)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.SPARKLE_HEAVY, x: 60, y:-20}), self);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "f6ff0b4a-0f7b-42d0-b955-1c484e50c595",
      "code": "//TEAM FRAY NOTE - period of strong attack prior to the charging animation.\r\n\r\n//calls a sparkle effect offset 5 pixels forward (x: 5) and up 70 pixels (y:-70)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.SPARKLE_HEAVY, x: 5, y:-70}), self);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "53a57a15-c26b-409f-8261-3e0ca8601a17",
      "code": "//TEAM FRAY NOTE - charging frame for strong attack. You can animate this portion however you'd like and it will work, just keep in mind Fraymakers characters typically charge on a singular frame for now if you're looking for parity. ",
      "length": 8,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "4612ee43-1fae-4331-a5be-3cac83959b1a",
      "code": null,
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "36d86455-0a4e-425b-985d-f338222a336e",
      "code": "//TEAM FRAY NOTE - period of strong attack prior to the charging animation.\r\n\r\n//calls a sparkle effect offset 50 pixels forward (x: 50) and up 20 pixels (y:-20)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.SPARKLE_HEAVY, x: 50, y:-20}), self);\r\n//calls a sparkle effect offset 50 pixels backward (x: -50), up 20 pixels (y:-20), and horizontally flipped (scaleX:-1)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.SPARKLE_HEAVY, x: -50, y:-20, scaleX:-1}), self);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "5786eaba-7bc2-47fc-a581-03b60217ab38",
      "code": "//TEAM FRAY NOTE - charging frame for strong attack. You can animate this portion however you'd like and it will work, just keep in mind Fraymakers characters typically charge on a singular frame for now if you're looking for parity. ",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "47202289-7406-4ff4-9371-e2e71dc6fcde",
      "code": "//plays generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "0acfd209-e290-462e-a29e-84be6228c61b",
      "code": "",
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "d4bb6f45-79e6-45c2-9ce7-062254c95029",
      "code": "//TEAM FRAY NOTE - for Fraymakers parity, the assist call animation is actionable on and after frame 5",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "8d9c813b-3204-4c95-b02c-b4c6255ccd82",
      "code": null,
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "293d099f-ea2b-4d3d-9d5a-b3f697d88d90",
      "code": "//Plays a specific sound clip\r\nAudioClip.play(self.getResource().getContent(\"downspecial\"));",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "89dffa20-0a02-415f-b4ff-ac1b1c34a659",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "174f5582-0f8e-4540-9a9d-4251389e3894",
      "code": "//TEAM FRAY NOTE - the grab hold point is where the enemy's origin point position will be placed during this animation.",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "fa9d9419-de32-405d-9fd0-0862a4c5e493",
      "code": "//brings grabbed character in front of your character\r\nself.getGrabbedFoe().bringInFront(self);\r\n//forces enemy character into frame 12 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(12);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "dc90adca-3b08-43c8-8ef7-1c0733bb5e7c",
      "code": "//brings grabbed character in front of your character\r\nself.getGrabbedFoe().bringInFront(self);\r\n//forces enemy character into frame 1 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(1);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "5a321899-a3d2-4480-b080-2da231c146df",
      "code": "//sends grabbed character behind your character\r\nself.getGrabbedFoe().sendBehind(self);\r\n//forces enemy character into frame 2 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(2);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "af46bd3b-cb03-4a05-a618-4e45ce031ad1",
      "code": "//sends grabbed character behind your character\r\nself.getGrabbedFoe().sendBehind(self);\r\n//forces enemy character into frame 2 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(2);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
