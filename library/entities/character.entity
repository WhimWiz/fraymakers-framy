    {
      "$id": "0acfa8bd-fa78-44ee-ab9e-4eacfbd02e81",
      "code": "//script which tells the character to go to the \"land_light\" animation if you land during the attack.\r\nCommon.setAutocancel(true);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "4345714d-6d54-4e19-bf77-72870be31c3f",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "a3fb8cdc-131d-4ee6-9c45-eb3ae6215db0",
      "code": "//script which tells the character to go to the land animation designated in the AnimationStats.hx for this attack if you land during it.\r\nCommon.setAutocancel(false);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "563e003f-1519-4cb4-9e74-f41462cb91f0",
      "code": "//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "a9824794-b50b-481e-89e6-510e86858581",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "08a4e911-5baf-47c8-b8d1-7b0778127687",
      "code": "//calls a light sparkle effect\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.SPARKLE_LIGHT, x: -90, y: -30}), self);\r\n//calls generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_2);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "1580225b-8d7c-46fc-bc89-194fada37c9d",
      "code": "",
      "length": 32,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bd7bdc3e-a04c-4d41-bad2-a12d8ecec297",
      "code": "//script which tells the character to go to the \"land_light\" animation if you land during the attack.\r\nCommon.setAutocancel(true);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e450fbfa-1df3-4a38-97ae-b7082d71694d",
      "code": "",
      "length": 8,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "291e9f71-9f6c-4fc7-a006-97e89a85d339",
      "code": "//script which allows you to act out of the rest of the animation\r\nCommon.setIASA(true);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
