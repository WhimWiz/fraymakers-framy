      "$id": "56273b79-1138-4daa-944b-f98048ea9c73",
      "code": "//calls a light dust effect\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.LAND_DUST}), self);\r\n",
