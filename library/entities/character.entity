    {
      "$id": "846f2eaa-2d6d-431c-a045-4f3dab536b2b",
      "code": "// TEAM FRAY NOTE - the order of this code is important. Set the speed first, and then change the state\r\n//applies ledge jump speed (configurable in CharacterStats.hx)\r\nCommon.applyLedgeJumpSpeed();\r\n//controls which state+animation you transition to (keep in mind you transition on the frame this script is called)\r\nself.toState(CState.JUMP_LOOP, \"jump_in\");",
