    {
      "$id": "623902f0-7dc2-40e3-9364-4a4e8c4a4e98",
      "code": "//script which tells the character to go to the \"land_light\" animation if you land during the attack.\r\nCommon.setAutocancel(true);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "61d0d33d-5d7c-40eb-93f9-7baf1e59c5bd",
      "code": "",
      "length": 4,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "3086ffff-55a3-49ba-8154-ba422d36600b",
      "code": "//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "5c69050d-9164-45df-8c5f-6d371c2de925",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "77c9ed92-da59-4387-80be-be8e2537cd7b",
      "code": "//calls generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_3);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "4a078182-b414-48c7-a4a1-8234d7ad52f0",
      "code": "//script which tells the character to go to the land animation designated in the AnimationStats.hx for this attack if you land during it.\r\nCommon.setAutocancel(false);\r\n//gives the character a speed boost forward and down (to set backward speed put a negative number in the setXSpeed parenthesis, and to go up set a negative number in the setYSpeed parenthesis)\r\nself.setXSpeed(5);\r\nself.setYSpeed(18);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "f9888093-2d40-444e-bc4c-ce5e8d974fc0",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "33973d5e-ad7e-4b25-af01-52687cb293e4",
      "code": null,
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "83a2da94-4741-4266-b761-3a72eb803441",
      "code": "",
      "length": 11,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "4d1a0ee4-71e0-444a-9b03-c07a634c6dce",
      "code": "//script which tells the character to go to the \"land_light\" animation if you land during the attack.\r\nCommon.setAutocancel(true);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "0956e20e-3906-4991-b8e9-ca2531048e11",
      "code": null,
