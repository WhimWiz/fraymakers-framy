    },
    {
      "$id": "d3158fd3-d5ee-46f6-a624-e048008dffcf",
      "code": "",
      "length": 2,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bd874c6f-31d5-4d48-8a81-a9eb841faf04",
      "code": "//forces enemy character into frame 12 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(12);\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "259d6113-498b-4ad1-ba62-01ad5d7e29fd",
      "code": "",
      "length": 5,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "d3dc2ea8-b21d-4613-805a-78c8a99cd049",
      "code": "//brings grabbed character in front of your character\r\nself.getGrabbedFoe().bringInFront(self);\r\n//forces enemy character into frame 10 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(10);\r\n}\r\n//plays throw sound \r\nAudioClip.play(\"global::sfx.throw\");",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "e5f80bc9-0632-4095-8176-9f0033e8aa3d",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "64bc6c9a-df63-4a16-bd07-9ddf5df07971",
      "code": "//calls light dust effect\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_START_LIGHT}), self);\r\n//forces enemy character into frame 9 of the \"hurt_thrown\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"hurt_thrown\")) {\r\n    self.getGrabbedFoe().playAnimation(\"hurt_thrown\");\r\n    self.getGrabbedFoe().playFrame(9);\r\n}\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "f09c23c1-b969-4a2b-b448-bb6f6c2b9f2d",
      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "070f8b2e-c743-4330-b0bb-ecb370381825",
      "code": "//calls ground bounce effect\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.GROUND_BOUNCE}), self);\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", layer:VfxLayer.CHARACTERS_BACK, animation: GlobalVfx.GROUND_BOUNCE_BACK}), self);\r\n//forces enemy character into \"crash_bounce\" animation\r\nif (self.getGrabbedFoe().hasAnimation(\"crash_bounce\")) {\r\n    self.getGrabbedFoe().playAnimation(\"crash_bounce\");\r\n}",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "7295ba60-17be-4ec5-b688-44dccde5c0d9",
      "code": "",
      "length": 18,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bb51786a-f624-43fa-b408-b1ff582e5488",
      "code": "//sends grabbed character behind your character\r\nself.getGrabbedFoe().sendBehind(self);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "3c5fc399-fb29-44f4-9cab-87aa7dcbac10",
      "code": "//calls generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_3);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
