    {
      "$id": "e213d87d-5578-4d68-b53f-c0a7d99282cd",
      "code": "//calls heavy dust effect flipped horizontally (scaleX: -1)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_START_HEAVY, scaleX: -1 }), self);\r\n//plays generic roll sound\r\nAudioClip.play(GlobalSfx.ROLL);\r\n\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "11a99e0e-1e9c-46ca-a6e8-268528b77c01",
      "code": "//calls heavy sparkle effect flipped horizontally (scaleX-1)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.SPARKLE_HEAVY, scaleX: -1 }), self);\r\n//set intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n\r\n\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "c8c03bc1-501e-46f3-981b-80848122bd21",
      "code": "",
      "length": 14,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "5531d7e6-7266-479e-9f7a-d03923afe452",
      "code": "//remove previously set intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.NONE});\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bfa4ddcb-a118-44c2-82c6-77f462e00704",
      "code": "",
      "length": 7,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "0a365c4a-99ab-476e-b1b0-3b0035458a09",
      "code": "//halts x speed\r\nself.setXSpeed(0);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "d11ddc4d-efd2-4f79-a1ba-15004d482ffb",
      "code": "",
      "length": 5,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "3f0183ce-c7ec-4da0-b612-9bd4e5ba2cdd",
      "code": "//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n//calls a dust poof effect\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_POOF}), self);\r\n//calls a dust poof effect behind the character\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", layer:VfxLayer.CHARACTERS_BACK, animation: GlobalVfx.DUST_POOF_BACK}), self);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "bab98a6a-6bfa-4dc0-b28b-2098bc35e12b",
      "code": "//removes previously set intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.NONE});\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
