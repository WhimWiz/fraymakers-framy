    {
      "$id": "7eeda4b2-5d1a-4780-894c-d030b535d7e7",
      "code": "//TEAM FRAY NOTE - plays directly from \"ledge_attack_in\" and you are no longer considered attached to the ledge. \r\n\r\n//sets intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.INTANGIBLE});\r\n//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "1e579cba-3df2-4412-af3c-e484c33f2a87",
      "code": "AudioClip.play(GlobalSfx.WHOOSH_3);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "b54cdf8a-7a58-4aa7-9cd5-72d51642fa78",
      "code": "//calls a light dust effect displaced 3 pixels downward (.., y:3}..)\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_START_LIGHT, y:3}), self);\r\n\r\n//removes previously set intangibility\r\nself.updateAnimationStats({bodyStatus:BodyStatus.NONE});\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "3097a307-7194-48d3-a917-7c4ba31eb81a",
      "code": "self.setXSpeed(10);\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "81a12e44-a73b-4e86-ba81-1f7942f831ad",
      "code": "",
      "length": 7,
