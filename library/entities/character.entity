      "code": "",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "fd9e54f9-a00b-4b5a-bd8d-1946f3e2ac2b",
      "code": "self.updateHitboxStats(0, {angle: 145});\r\nself.updateHitboxStats(1, {angle: 155});",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "6af7acfe-bbf7-43a3-87b5-31ec763dc5ad",
      "code": "self.updateHitboxStats(0, {angle: 140});\r\nself.updateHitboxStats(1, {angle: 150});",
