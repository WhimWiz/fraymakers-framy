    {
      "$id": "3bde91d3-663b-4c82-98e2-1939b77f7113",
      "code": "//TEAM FRAY NOTE - plays when you airdash into a floor.\r\n\r\n//calls a dust poof\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", animation: GlobalVfx.DUST_POOF}), self);\r\n//calls a separate dust poof behind the character\r\nmatch.createVfx(new VfxStats({spriteContent: \"global::vfx.vfx\", layer:VfxLayer.CHARACTERS_BACK, animation: GlobalVfx.DUST_POOF_BACK}), self);\r\n\r\n//reduces waveland speed based on the provided arguments\r\nCommon.reduceWavelandSpeed(11, 0.9);",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
