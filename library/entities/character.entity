    {
      "$id": "babaf2d5-a8c5-4e49-afd2-a0dc2d86269d",
      "code": "//calls generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_2);\r\n//plays a randomized attack voice sound from the character's attackVoiceIds character stat.\r\nself.playAttackVoice();",
