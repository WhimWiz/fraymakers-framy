    {
      "$id": "cddf1b9b-d0fd-4775-89a7-a2df50a56d80",
      "code": "//plays generic whoosh sound\r\nAudioClip.play(GlobalSfx.WHOOSH_1);\r\n//refreshes the hitboxes on the animation, allowing for multi-hit behavior\r\nself.reactivateHitboxes();\r\n",
      "length": 1,
      "pluginMetadata": {
      },
      "type": "FRAME_SCRIPT"
    },
    {
      "$id": "8255a2cc-2f76-44fb-88c9-ebcacdbc7b7e",
      "code": "",
      "length": 2,
